{
  "name": "ris-ktx2",
  "version": "0.1.0",
  "description": "Browser TypeScript wrapper around Khronos libktx for loading, creating, and transcoding KTX2 textures.",
  "type": "module",
  "author": "Luka Erkapic <erkapic.luka.dev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/luka712/ris-ktx2-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka712/ris-ktx2-ts.git"
  },
  "bugs": {
    "url": "https://github.com/luka712/ris-ktx2-ts/issues"
  },
  "keywords": [
    "ktx",
    "ktx2",
    "texture",
    "libktx",
    "wasm",
    "webassembly",
    "basis-universal",
    "vulkan",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "libktx.js",
    "libktx.wasm",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && vite build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ris-ktx2-api": "^0.1.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^1.6.0"
  }
}
